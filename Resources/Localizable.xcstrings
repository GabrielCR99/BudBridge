    "The earbuds accept one controller at a time. Use Release to Phone before opening the QCY app on your phone.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os fones aceitam um controle por vez. Use Liberar para o Celular antes de abrir o app QCY no celular."
          }
        }
      }
    },
    "The earbuds are free for the QCY app on your phone.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os fones estão livres para o app QCY no celular."
          }
        }
      }
    },
    "The earbuds didn't accept the connection. Take them out of the case and try again.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os fones não aceitaram a conexão. Tire-os do estojo e tente novamente."

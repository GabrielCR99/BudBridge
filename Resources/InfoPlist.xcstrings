    "NSBluetoothAlwaysUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BudBridge connects to your QCY earbuds to show battery and change noise control, equalizer and other settings."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O BudBridge se conecta aos seus fones QCY para mostrar a bateria e alterar o controle de ruído, o equalizador e outros ajustes."
          }
        }
      }
    },
